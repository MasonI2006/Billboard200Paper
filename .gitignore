# Raw inputs (read-only, never committed)
data/raw/

# MusicBrainz caches and large collected tables (never delete; rebuilt only via rate-limited API)
data/external/*
# small API error logs are tracked
!data/external/musicbrainz_artist_search_errors.jsonl
!data/external/musicbrainz_discography_api_errors.jsonl

# Intermediates and environments
*.pkl
__pycache__/
*.pyc
.venv/
archive/venv_msys_py312/
